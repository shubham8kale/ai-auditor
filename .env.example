# Local development only; production refuses local authentication.
AUDITOR_ENV=development
AUDITOR_LOCAL_AUTH=true
DATABASE_URL=sqlite:///./data/auditor.db
DATABASE_PASSWORD=
STORAGE_ROOT=./data/files
FRONTEND_ORIGIN=http://localhost:5173

# Hosted deployment: set AUDITOR_ENV=production, AUDITOR_LOCAL_AUTH=false.
# Use the Supabase transaction/session pooler URI with postgresql+psycopg://.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audit-evidence

# Free API only. Enable Zero Data Retention in the Groq organization first.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_ZDR_CONFIRMED=false
MAX_UPLOAD_MB=12
